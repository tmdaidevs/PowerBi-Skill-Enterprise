{
  "name": "Enterprise Style Guide",
  "version": "1.0.0",
  "description": "Full-featured enterprise style guide demonstrating all extended schema sections. Replace colors, fonts, and logos with your brand.",
  "theme": {
    "primaryColor": "#0078D4",
    "backgroundColor": "#F5F5F5",
    "textColor": "#1A1A1A",
    "dataColors": ["#0078D4", "#2B88D8", "#71AFE5", "#C7E0F4", "#004578", "#005A9E", "#106EBE", "#DEECF9"]
  },
  "typography": {
    "titleFontFamily": "Segoe UI Semibold",
    "bodyFontFamily": "Segoe UI",
    "titleFontSize": 24,
    "bodyFontSize": 10,
    "fontFamily": "Segoe UI",
    "elements": {
      "pageTitle": { "size": 24, "weight": "Regular" },
      "subtitle": { "size": 9, "weight": "Regular" },
      "visualTitle": { "size": 18, "weight": "Bold" },
      "filterBarTitle": { "size": 12, "weight": "Regular" },
      "axisLabels": { "size": 10, "weight": "Regular" },
      "filterValues": { "size": 8, "weight": "Regular" },
      "tableHeaders": { "size": 10, "weight": "Bold" },
      "tableTotals": { "size": 12, "weight": "Bold" },
      "kpiValues": { "size": 15, "weight": "Regular" }
    }
  },
  "layout": {
    "pagePadding": 16,
    "visualSpacing": 24,
    "cornerRadius": 0,
    "dimensionSnap": 4
  },
  "rules": {
    "maxVisualsPerPage": 6,
    "allowCustomVisuals": true,
    "enforceTopRowKpis": true,
    "approvedFonts": ["Segoe UI", "Segoe UI Semibold"]
  },
  "colors": {
    "reportPalette": {
      "primary": [
        { "name": "White", "hex": "#FFFFFF", "usage": "Text on dark backgrounds, visual backgrounds" },
        { "name": "Black", "hex": "#1A1A1A", "usage": "Main text, titles" },
        { "name": "Brand Primary", "hex": "#0078D4", "usage": "Primary color, links" },
        { "name": "Header Gray", "hex": "#333333", "usage": "Table header background" },
        { "name": "Muted Text", "hex": "#C9C9C9", "usage": "Filter labels, secondary text" }
      ],
      "secondary": [
        { "name": "Page Background", "hex": "#F5F5F5", "usage": "Default page background, zebra rows" },
        { "name": "Border Gray", "hex": "#E8E8E8", "usage": "Subtle borders and dividers" }
      ]
    },
    "visualPalette": [
      { "name": "Blue 1", "hex": "#0078D4" },
      { "name": "Blue 2", "hex": "#2B88D8" },
      { "name": "Blue 3", "hex": "#71AFE5" },
      { "name": "Blue 4", "hex": "#C7E0F4" },
      { "name": "Blue 5", "hex": "#004578" },
      { "name": "Blue 6", "hex": "#005A9E" },
      { "name": "Blue 7", "hex": "#106EBE" },
      { "name": "Blue 8", "hex": "#DEECF9" }
    ],
    "sentiment": {
      "positive": "#107C10",
      "negative": "#D13438",
      "neutral": "#CA5010"
    },
    "divergent": {
      "max": "#004578",
      "middle": "#2B88D8",
      "min": "#C7E0F4"
    },
    "themeAdvanced": {
      "firstLevel": "#1A1A1A",
      "secondLevel": "#1A1A1A",
      "thirdLevel": "#F5F5F5",
      "fourthLevel": "#C9C9C9",
      "background": "#FFFFFF",
      "secondaryBackground": "#C9C9C9"
    }
  },
  "pageStructure": {
    "canvas": { "width": 1280, "height": 720 },
    "header": {
      "height": 64,
      "backgroundColor": "#1A1A1A",
      "elements": {
        "logoLeft": { "width": 40, "height": 40, "x": 16, "y": 12, "name": "Company Logo" },
        "logoRight": { "width": 64, "height": 32, "x": 1200, "y": 16, "name": "Product Logo" }
      }
    },
    "footer": {
      "height": 32,
      "backgroundColor": "#1A1A1A",
      "elements": {
        "logoLeft": { "width": 32, "height": 32, "x": 16, "y": 688, "name": "Company Logo Footer" }
      },
      "navigationItems": ["Home", "Overview", "Details", "FAQ", "Help"]
    },
    "filterPanel": {
      "side": "right",
      "width": 200,
      "topPadding": 18,
      "backgroundColor": "#1A1A1A"
    },
    "body": {
      "leftMargin": 40,
      "rightMargin": 24,
      "topMargin": 32,
      "bottomMargin": 16,
      "innerPadding": 24,
      "interVisualGap": 24
    }
  },
  "visualTypeRules": {
    "table": {
      "variants": {
        "v1": {
          "header": { "bgColor": "#333333", "fontSize": 10, "fontWeight": "Bold", "fontColor": "#FFFFFF" },
          "values": { "bgColor": ["#F5F5F5", "#FFFFFF"], "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
          "total": { "bgColor": "#FFFFFF", "fontSize": 12, "fontWeight": "Regular", "fontColor": "#333333" }
        },
        "v2": {
          "header": { "bgColor": "#FFFFFF", "fontSize": 10, "fontWeight": "Bold", "fontColor": "#333333" },
          "values": { "bgColor": ["#F5F5F5", "#FFFFFF"], "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
          "total": { "bgColor": "#333333", "fontSize": 12, "fontWeight": "Regular", "fontColor": "#FFFFFF" }
        }
      },
      "defaultVariant": "v1"
    },
    "matrix": {
      "header": { "bgColor": "#333333", "fontSize": 10, "fontWeight": "Bold", "fontColor": "#FFFFFF" },
      "values": { "bgColor": ["#F5F5F5", "#FFFFFF"], "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "total": { "bgColor": "#FFFFFF", "fontSize": 12, "fontWeight": "Regular", "fontColor": "#333333" }
    },
    "lineChart": {
      "xAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "yAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "legend": { "position": "TopLeft", "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "stackedChart": {
      "xAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "yAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "legend": { "position": "TopLeft", "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "comboChart": {
      "xAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "yAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "legend": { "position": "TopLeft", "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "barChart": {
      "xAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "yAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "kpiCard": {
      "labels": { "fontSize": 15, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "gauge": {
      "labels": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "areaChart": {
      "xAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" },
      "yAxis": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "waterfall": {
      "labels": { "fontSize": 10, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    },
    "donutChart": {
      "labels": { "fontSize": 8, "fontWeight": "Regular", "fontColor": "#1A1A1A" }
    }
  },
  "visualRules": {
    "barChart": {
      "showBorder": false,
      "titleAlignment": "left"
    },
    "table": {
      "alternatingRows": true
    }
  }
}
